VITE_EMAILJS_PUBLIC_KEY=your_public_key
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id

# SHA-256 hash (hex) of the password that gates /protected-task-board.
# This is a soft deterrent only — the hash ships in the client bundle, so
# never put the plaintext password (or a value you actually care about) here.
# Generate the hash with Node:
#   node -e "crypto.subtle.digest('SHA-256', new TextEncoder().encode('your-password')).then(b => console.log(Buffer.from(b).toString('hex')))"
# or in the browser devtools console:
#   crypto.subtle.digest('SHA-256', new TextEncoder().encode('your-password')).then(b => console.log([...new Uint8Array(b)].map(x => x.toString(16).padStart(2,'0')).join('')))
VITE_TASKBOARD_PASSWORD_HASH=paste_generated_hash_here
